DISCORD_TOKEN=PEGAR_TOKEN_AQUI

# ── Opcionales (estos son los valores por defecto) ───────────────────────────
# IVA sobre servicios digitales que cobra la tarjeta al pagar en pesos
IVA_PERCENT=21
# Ingresos Brutos de tu provincia (ej. 2 para CABA/PBA). 0 = sin IIBB
PROVINCE_TAX_PERCENT=0
# Cada cuántos segundos se actualiza la cotización del dólar
EXCHANGE_RATE_TTL_SECONDS=1800
# Hora de Argentina a la que se publican las ofertas del día
DEALS_HOUR=12
# Hora de Argentina a la que se publica el fondo del día de Wallpaper Engine
WALLPAPER_HOUR=18
# Monitor externo (healthchecks.io): recibe un latido cada 5 minutos y avisa por mail si
# deja de llegar. Vacío = sin monitoreo
HEALTHCHECK_URL=
# Archivo de la base de datos SQLite
DATABASE_FILE=data/vapora.db
