# Servicio systemd para Vapora.
# Instalación: sudo cp deploy/vapora.service /etc/systemd/system/
#              sudo systemctl daemon-reload && sudo systemctl enable --now vapora
[Unit]
Description=Vapora - bot de Discord con precios de Steam en pesos argentinos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/vapora
ExecStart=/home/ubuntu/vapora/.venv/bin/python bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
